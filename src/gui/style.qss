/* ================================================================
   GRAMATRIX — BRUTALIST THEME 
   Philosophy: Raw structure. No glass. No gradients. No mercy.
   Palette:
     Background:  #F0EBE0  (raw concrete paper)
     Surface:     #FFFFFF  #111111  #0A0A0A
     Accent:      #FFE000  (brutal yellow)
     Hot:         #FF3C3C  (danger red)
     Cold:        #00E5CC  (terminal cyan)
     Muted:       #7C7C7C  (concrete grey)
     Border:      #111111  (thick, black)
     Text:        #111111  #FFFFFF  #AAAAAA
   ================================================================ */

/* ── Base ───────────────────────────────────────────────────────── */
QWidget {
    color: #111111;
    font-family: "Segoe UI";
}

/* ── Root / Window ───────────────────────────────────────────────── */
QMainWindow {
    background-color: #F0EBE0;
}

QWidget#RootBackground {
    background-color: #F0EBE0;
}

/* ── Brutal Panel ────────────────────────────────────────────────── */
QFrame#GlassPanel {
    background-color: #FAFAFA;
    border: 3px solid #111111;
    border-radius: 0px;
}

/* ── Sidebar ─────────────────────────────────────────────────────── */
QFrame#Sidebar {
    background-color: #0A0A0A;
    border: none;
    border-right: 3px solid #FFE000;
    border-radius: 0px;
}

/* ── Logo ────────────────────────────────────────────────────────── */
QLabel#LogoIcon {
    font-family: "Material Icons";
    color: #FFE000;
    font-size: 20px;
    background: transparent;
}
QLabel#LogoText {
    color: #FFE000;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 5px;
    background: transparent;
}

QLabel#NavIcon {
    font-family: "Material Icons";
    font-size: 20px;
    background: transparent;
}
QLabel#ExitIcon {
    font-family: "Material Icons";
    font-size: 20px;
    background: transparent;
}

/* ── Divider ─────────────────────────────────────────────────────── */
QFrame#Divider {
    background-color: #2A2A2A;
    max-height: 2px;
    min-height: 2px;
    border: none;
    margin: 3px 0px;
}

/* ── Section Labels ──────────────────────────────────────────────── */
QLabel#SectionLabel {
    color: #00E5CC;
    font-size: 8px;
    font-weight: 900;
    letter-spacing: 4px;
    padding: 10px 14px 2px 14px;
    background: transparent;
}

/* ── Sidebar Toggle (chevron strip) ──────────────────────────────── */
QWidget#ToggleWrap { background: transparent; }

QPushButton#SidebarToggle {
    background-color: #FFE000;
    border: 3px solid #FFE000;
    border-left: none;
    border-radius: 0px;
    color: #111111;
    padding: 0px;
    font-weight: 900;
    font-family: "Material Icons";
}
QPushButton#SidebarToggle:hover {
    background-color: #FFD000;
    color: #111111;
    border-color: #FFD000;
}
QPushButton#SidebarToggle:pressed {
    background-color: #E5C900;
    color: #111111;
}

/* ── Global: kill focus rectangles on all buttons ────────────────── */
QPushButton:focus {
    outline: none;
}
QPushButton#NavButton:focus,
QPushButton#ExitButton:focus,
QPushButton#SidebarToggle:focus,
QPushButton#BackButton:focus {
    outline: none;
    border-style: solid;   
}

/* ── Nav Buttons ─────────────────────────────────────────────────── */
QPushButton#NavButton {
    border: 2px solid transparent;
    border-radius: 0px;
    background-color: transparent;
    min-height: 42px;
    color: #E0E0E0;
    text-align: left;
}

/* HOVER → brutal highlight */
QPushButton#NavButton:hover {
    background-color: #1C1C1C;
    border: 2px solid #FFE000;
    color: #FFE000;
}

QPushButton#NavButton:checked {
    background-color: #1C1C1C;
    border: 2px solid #FFE000;
    color: #FFE000;
}

/* PRESSED */
QPushButton#NavButton:pressed {
    background-color: #FFD000;
    color: #111111;
}

/* ── Nav Button Child Labels ─────────────────────────────────────── */
QPushButton#NavButton QLabel {
    background: transparent;
    color: #E0E0E0;
}
QPushButton#NavButton:hover QLabel {
    color: #FFE000;
}
QPushButton#NavButton:checked QLabel {
    color: #FFE000;
}

/* ── Exit Button ─────────────────────────────────────────────────── */
QPushButton#ExitButton {
    border: 2px solid #FF3C3C;
    border-radius: 0px;
    background-color: transparent;
    min-height: 42px;
    color: #FF3C3C;
}
QPushButton#ExitButton QLabel {
    color: #FF3C3C;
    background: transparent;
    font-weight: 700;
}
QPushButton#ExitButton:hover {
    background-color: #FF3C3C;
    border: 2px solid #FF3C3C;
    color: #FFFFFF;
}
QPushButton#ExitButton:hover QLabel {
    color: #FFFFFF;
}
QPushButton#ExitButton:pressed {
    background-color: #CC2020;
    color: #FFFFFF;
}

/* ── Page Card ───────────────────────────────────────────────────── */
QFrame#PageCard {
    background-color: #F0EBE0;
    border: 3px solid #111111;
    border-radius: 0px;
}

/* ── Page Icon ───────────────────────────────────────────────────── */
QLabel#PageIcon {
    font-family: "Material Icons";
    font-size: 58px;
    color: #111111;
    padding: 8px;
}

/* ── Page Title ──────────────────────────────────────────────────── */
QLabel#PageTitle {
    color: #111111;
    font-size: 32px;
    font-weight: 900;
    letter-spacing: 2px;
    font-family: "Segoe UI";
}

/* ── Typing Label ────────────────────────────────────────────────── */
QLabel#TypingLabel {
    color: #00E5CC;
    font-size: 11px;
    letter-spacing: 3px;
    font-family: "Consolas", "Courier New", monospace;
    font-weight: 700;
}

/* ── Back Button ─────────────────────────────────────────────────── */
QPushButton#BackButton {
    background-color: #FFE000;
    border: 3px solid #111111;
    border-radius: 0px;
    padding: 7px 18px;
    color: #111111;
    font-size: 11px;
    font-weight: 900;
    letter-spacing: 2px;
}
QPushButton#BackButton:hover {
    background-color: #111111;
    color: #FFE000;
    border-color: #111111;
}
QPushButton#BackButton:pressed {
    background-color: #333333;
    color: #FFE000;
}

/* ── Scrollbar ───────────────────────────────────────────────────── */
QScrollBar:vertical {
    background: #1A1A1A;
    width: 6px;
    margin: 0px;
    border: none;
}
QScrollBar::handle:vertical {
    background: #444444;
    min-height: 24px;
}
QScrollBar::handle:vertical:hover {
    background: #FFE000;
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    background: #1A1A1A;
}

/* ── Status tags / accent chips ─────────────────────────────────── */
QLabel#TagCyan {
    background-color: #00E5CC;
    color: #0A0A0A;
    font-weight: 900;
    font-size: 9px;
    letter-spacing: 2px;
    padding: 2px 6px;
    border: 2px solid #00E5CC;
}
QLabel#TagRed {
    background-color: #FF3C3C;
    color: #FFFFFF;
    font-weight: 900;
    font-size: 9px;
    letter-spacing: 2px;
    padding: 2px 6px;
    border: 2px solid #FF3C3C;
}
QLabel#TagYellow {
    background-color: #FFE000;
    color: #111111;
    font-weight: 900;
    font-size: 9px;
    letter-spacing: 2px;
    padding: 2px 6px;
    border: 2px solid #111111;
}
